{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supervised search and approach episode v1",
  "oneOf": [
    {
      "$ref": "#/$defs/grant"
    },
    {
      "$ref": "#/$defs/state"
    },
    {
      "$ref": "#/$defs/fixture"
    }
  ],
  "$defs": {
    "grant": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "go2-five-move-episode-v1"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "instruction_id": {
          "type": "string",
          "minLength": 1
        },
        "trial_id": {
          "type": "string",
          "minLength": 1
        },
        "clock_epoch": {
          "type": "string",
          "minLength": 1
        },
        "capability_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "issued": {
          "type": "number"
        },
        "deadline": {
          "type": "number"
        },
        "origin": {
          "type": "object",
          "properties": {
            "frame": {
              "type": "string",
              "minLength": 1
            },
            "robot_epoch": {
              "type": "string",
              "minLength": 1
            },
            "monotonic_s": {
              "type": "number"
            },
            "x_m": {
              "type": "number"
            },
            "y_m": {
              "type": "number"
            },
            "yaw_rad": {
              "type": "number"
            }
          },
          "required": [
            "frame",
            "robot_epoch",
            "monotonic_s",
            "x_m",
            "y_m",
            "yaw_rad"
          ],
          "additionalProperties": false
        },
        "alignment_deg": {
          "type": "number",
          "minimum": 8,
          "maximum": 18
        },
        "area_radius_m": {
          "type": "number",
          "minimum": 1.2,
          "maximum": 3
        },
        "max_moves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "area_inspected": {
          "const": true
        },
        "exclusive_and_intervention_confirmed": {
          "const": true
        }
      },
      "required": [
        "schema",
        "episode_id",
        "operator",
        "target",
        "instruction",
        "session_id",
        "instruction_id",
        "trial_id",
        "clock_epoch",
        "capability_sha256",
        "issued",
        "deadline",
        "origin",
        "alignment_deg",
        "area_radius_m",
        "max_moves",
        "area_inspected",
        "exclusive_and_intervention_confirmed"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "go2-five-move-episode-v1"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "IDLE",
            "OBSERVING",
            "IDENTIFYING",
            "MOVING",
            "TERMINAL"
          ]
        },
        "mode": {
          "enum": [
            "SEARCH",
            "APPROACH"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            null,
            "GOAL_CONFIRMED",
            "MODEL_STOPPED_ARRIVAL_UNVERIFIED",
            "MOVE_BUDGET_EXHAUSTED",
            "BLOCKED_OR_NO_USEFUL_ACTION",
            "SENSOR_OR_CONTROL_FAILURE",
            "OPERATOR_ABORT",
            "EPISODE_DEADLINE"
          ]
        },
        "target_found": {
          "type": "boolean"
        },
        "moves": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "max_moves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "attempts": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "action_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "prediction_id": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "enum": [
                  "SEARCH",
                  "APPROACH"
                ]
              },
              "direction": {
                "enum": [
                  "left",
                  "right",
                  "forward"
                ]
              },
              "requested": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "enum": [
                  "m",
                  "rad"
                ]
              },
              "source": {
                "enum": [
                  "search_policy",
                  "approach_policy",
                  "native_prefix",
                  "native_search_prefix"
                ]
              }
            },
            "required": [
              "slot",
              "action_id",
              "prediction_id",
              "mode",
              "direction",
              "requested",
              "unit",
              "source"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "schema",
        "episode_id",
        "state",
        "mode",
        "reason",
        "outcome",
        "target_found",
        "moves",
        "max_moves",
        "attempts"
      ],
      "additionalProperties": true
    },
    "fixture": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "go2-five-move-episode-v1"
        },
        "synthetic": {
          "const": true
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "opos": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1296
              },
              "extent_m": {
                "type": "number"
              },
              "yaw_deg": {
                "type": "number"
              },
              "stop": {
                "type": "boolean"
              },
              "expected": {
                "type": "string",
                "minLength": 1
              },
              "advance_after": {
                "enum": [
                  "left",
                  "right",
                  "forward"
                ]
              }
            },
            "required": [
              "opos",
              "extent_m",
              "yaw_deg",
              "stop",
              "expected"
            ],
            "additionalProperties": false
          }
        },
        "expected_moves": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "expected_outcome": {
          "enum": [
            "GOAL_CONFIRMED",
            "MODEL_STOPPED_ARRIVAL_UNVERIFIED",
            "MOVE_BUDGET_EXHAUSTED",
            "BLOCKED_OR_NO_USEFUL_ACTION",
            "SENSOR_OR_CONTROL_FAILURE",
            "OPERATOR_ABORT",
            "EPISODE_DEADLINE"
          ]
        }
      },
      "required": [
        "schema",
        "synthetic",
        "target",
        "note",
        "decisions",
        "expected_moves",
        "expected_outcome"
      ],
      "additionalProperties": false
    }
  }
}
